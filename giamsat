import tkinter as tk
from tkinter import ttk
import subprocess
import platform
import threading
import time
import concurrent.futures  # Thư viện để chạy song song (Multithreading)

class DeviceMonitor:
    def __init__(self, root):
        self.root = root
        self.root.title("Giám Sát Thiết Bị - High Performance")
        self.root.geometry("900x550")
        
        # --- GIAO DIỆN ---
        # Header
        header_frame = tk.Frame(root, bg="#2c3e50", pady=15)
        header_frame.pack(fill=tk.X)
        lbl_title = tk.Label(header_frame, text="HỆ THỐNG GIÁM SÁT MẠNG TẬP TRUNG",
                            font=("Segoe UI", 16, "bold"), bg="#2c3e50", fg="white")
        lbl_title.pack()
        
        # Status Bar
        self.status_var = tk.StringVar(value="Đang khởi tạo hệ thống...")
        status_bar = tk.Label(root, textvariable=self.status_var,
                              font=("Segoe UI", 10), bg="#ecf0f1", fg="#333", anchor="w", padx=10, pady=5)
        status_bar.pack(side=tk.BOTTOM, fill=tk.X)
        
        # Treeview (Bảng dữ liệu)
        tree_frame = tk.Frame(root)
        tree_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        
        # Scrollbar (Thanh cuộn)
        self.scrollbar = ttk.Scrollbar(tree_frame, orient="vertical")
        
        columns = ("STT", "Tên Thiết Bị", "IP", "Trạng thái", "Phản hồi (ms)", "Cập nhật lúc")
        self.tree = ttk.Treeview(tree_frame, columns=columns, show="headings",
                                 yscrollcommand=self.scrollbar.set, height=20)
        
        self.scrollbar.config(command=self.tree.yview)
        self.scrollbar.pack(side="right", fill="y")
        self.tree.pack(side="left", fill="both", expand=True)
        
        # Cấu hình cột
        col_width = {
            "STT": 50, "Tên Thiết Bị": 200, "IP": 150,
            "Trạng thái": 120, "Phản hồi (ms)": 100, "Cập nhật lúc": 120
        }
        for col, width in col_width.items():
            self.tree.column(col, width=width, anchor="center" if col != "Tên Thiết Bị" else "w")
            self.tree.heading(col, text=col)
        
        # Màu sắc
        self.tree.tag_configure("online", background="#d4edda", foreground="#155724")  # Xanh lá
        self.tree.tag_configure("offline", background="#f8d7da", foreground="#721c24")  # Đỏ
        
        # --- DỮ LIỆU & XỬ LÝ ---
        self.devices = self.load_devices()
        self.item_ids = {}  # Map IP -> Item ID trong Treeview
        
        # Tạo bảng ban đầu (Chỉ chạy 1 lần duy nhất để tránh nhảy màn hình)
        self.init_table()
        
        # Cờ kiểm soát luồng
        self.is_running = True
        self.start_monitoring()
    
    def load_devices(self):
        """Load danh sách hoặc tạo dữ liệu mẫu"""
        devices = []
        try:
            with open("D:\\danhsach.txt", "r", encoding="utf-8") as f:
                for line in f:
                    if "," in line:
                        name, ip = line.split(",", 1)
                        devices.append({"name": name.strip(), "ip": ip.strip()})
        except FileNotFoundError:
            # Dữ liệu mẫu (nhiều dòng để test cuộn chuột)
            for i in range(1, 31):
                devices.append({"name": f"Camera Khu Vực {i}", "ip": f"192.168.1.{100+i}"})
            # Thêm vài IP thật để test
            devices.insert(0, {"name": "Google DNS", "ip": "8.8.8.8"})
            devices.insert(1, {"name": "Cloudflare", "ip": "1.1.1.1"})
            devices.insert(2, {"name": "Localhost", "ip": "127.0.0.1"})
        
        return devices
    
    def init_table(self):
        """Khởi tạo các dòng trong bảng. TUYỆT ĐỐI KHÔNG XÓA ĐI TẠO LẠI."""
        for idx, dev in enumerate(self.devices, 1):
            item_id = self.tree.insert("", "end", values=(
                idx, dev["name"], dev["ip"], "⏳ Đang tải...", "--", "--"
            ))
            self.item_ids[dev["ip"]] = item_id
    
    def check_ping(self, device):
        """Hàm thực hiện ping (Chạy trong thread con)"""
        ip = device["ip"]
        param = "-n" if platform.system().lower() == "windows" else "-c"
        # Timeout cực ngắn (500ms) để phản hồi nhanh
        command = ["ping", param, "1", "-w", "500", ip]
        
        try:
            # Đo thời gian phản hồi giả lập (hoặc parse từ output ping nếu cần kỹ hơn)
            start_t = time.time()
            res = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            end_t = time.time()
            
            ms = int((end_t - start_t) * 1000) if res.returncode == 0 else 0
            return {
                "ip": ip,
                "is_online": res.returncode == 0,
                "ms": ms
            }
        except:
            return {"ip": ip, "is_online": False, "ms": 0}
    
    def update_ui_row(self, result):
        """Cập nhật 1 dòng cụ thể - CHỈ chạy trên Main Thread"""
        ip = result["ip"]
        item_id = self.item_ids.get(ip)
        
        if not item_id: return
        
        # Dữ liệu mới
        status_text = "🟢 ONLINE" if result["is_online"] else "🔴 OFFLINE"
        tag = "online" if result["is_online"] else "offline"
        ms_text = f"{result['ms']} ms" if result["is_online"] else "Timeout"
        curr_time = time.strftime("%H:%M:%S")
        
        # Lấy dữ liệu cũ
        old_values = self.tree.item(item_id, "values")
        
        # So sánh: Nếu trạng thái chưa đổi thì chỉ cập nhật thời gian (giảm flicker)
        # old_values[3] là cột Trạng thái
        if old_values[3] == status_text:
            # Chỉ cập nhật ping và thời gian, giữ nguyên các cột khác
            new_values = (old_values[0], old_values[1], ip, status_text, ms_text, curr_time)
        else:
            # Cập nhật toàn bộ nếu trạng thái đổi
            new_values = (old_values[0], old_values[1], ip, status_text, ms_text, curr_time)
        
        # Cập nhật vào Treeview
        self.tree.item(item_id, values=new_values, tags=(tag,))
    
    def batch_update_ui(self, results, online_cnt, offline_cnt):
        # Lưu vị trí cuộn hiện tại
        scroll_pos = self.tree.yview()[0]
        
        # Cập nhật tất cả các hàng
        for result in results:
            self.update_ui_row(result)
        
        # Khôi phục vị trí cuộn
        self.tree.yview_moveto(scroll_pos)
        
        # Cập nhật thanh trạng thái
        total_dev = len(self.devices)
        msg = f"Tổng: {total_dev} | 🟢 Online: {online_cnt} | 🔴 Offline: {offline_cnt} | ♻️ Tự động làm mới sau 5s"
        self.status_var.set(msg)
    
    def monitoring_loop(self):
        """Vòng lặp chính quản lý ThreadPool"""
        while self.is_running:
            # SỬ DỤNG THREAD POOL ĐỂ PING SONG SONG
            # Max_workers=20 nghĩa là ping 20 thiết bị cùng 1 lúc
            with concurrent.futures.ThreadPoolExecutor(max_workers=20) as executor:
                # Gửi tất cả lệnh ping vào pool
                futures = [executor.submit(self.check_ping, dev) for dev in self.devices]
                
                # Chờ tất cả hoàn thành và thu thập kết quả
                results = []
                online_cnt = 0
                offline_cnt = 0
                for future in futures:
                    if not self.is_running: return
                    result = future.result()
                    results.append(result)
                    if result["is_online"]:
                        online_cnt += 1
                    else:
                        offline_cnt += 1
            
            # Đẩy việc cập nhật giao diện về Main Thread (batch update để tránh flicker và cuộn)
            if self.is_running:
                self.root.after(0, self.batch_update_ui, results, online_cnt, offline_cnt)
            
            # Nghỉ 5 giây (đếm lùi để có thể tắt app mượt mà)
            for _ in range(50):
                if not self.is_running: break
                time.sleep(0.1)
    
    def start_monitoring(self):
        t = threading.Thread(target=self.monitoring_loop, daemon=True)
        t.start()
        
    def on_close(self):
        self.is_running = False
        self.root.destroy()

if __name__ == "__main__":
    root = tk.Tk()
    app = DeviceMonitor(root)
    root.protocol("WM_DELETE_WINDOW", app.on_close)
    root.mainloop()
