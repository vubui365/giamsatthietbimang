import tkinter as tk
from tkinter import ttk
import subprocess
import platform
import threading
import time

class DeviceMonitor:
    def __init__(self, root):
        self.root = root
        self.root.title("Giám Sát Thiết Bị - Real-time")
        self.root.geometry("800x500")
        
        # Tiêu đề
        title = tk.Label(root, text="🖥️ HỆ THỐNG GIÁM SÁT THIẾT BỊ", 
                        font=("Arial", 16, "bold"), bg="#2c3e50", fg="white", pady=10)
        title.pack(fill=tk.X)
        
        # Frame chứa thông tin
        info_frame = tk.Frame(root, bg="#ecf0f1", pady=5)
        info_frame.pack(fill=tk.X, padx=10)
        
        self.status_label = tk.Label(info_frame, text="⏱️ Đang khởi động...", 
                                     font=("Arial", 10), bg="#ecf0f1", fg="#34495e")
        self.status_label.pack(side=tk.LEFT, padx=10)
        
        # Frame chứa Treeview và Scrollbar
        tree_frame = tk.Frame(root)
        tree_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)
        
        # Tạo bảng hiển thị
        self.tree = ttk.Treeview(tree_frame, 
                                 columns=("STT", "Tên", "IP", "Trạng thái", "Thời gian"), 
                                 show="headings", height=15)
        
        # Định nghĩa cột
        self.tree.heading("STT", text="STT")
        self.tree.heading("Tên", text="Tên Thiết Bị")
        self.tree.heading("IP", text="Địa Chỉ IP")
        self.tree.heading("Trạng thái", text="Trạng Thái")
        self.tree.heading("Thời gian", text="Cập Nhật Lúc")
        
        # Độ rộng cột
        self.tree.column("STT", width=50, anchor="center")
        self.tree.column("Tên", width=200)
        self.tree.column("IP", width=150, anchor="center")
        self.tree.column("Trạng thái", width=120, anchor="center")
        self.tree.column("Thời gian", width=150, anchor="center")
        
        # Thanh cuộn
        scrollbar = ttk.Scrollbar(tree_frame, orient=tk.VERTICAL, command=self.tree.yview)
        self.tree.configure(yscroll=scrollbar.set)
        
        self.tree.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
        scrollbar.pack(side=tk.RIGHT, fill=tk.Y)
        
        # Màu sắc cho trạng thái
        self.tree.tag_configure("online", background="#d4edda", foreground="#155724")
        self.tree.tag_configure("offline", background="#f8d7da", foreground="#721c24")
        
        # Đọc danh sách thiết bị
        self.devices = self.load_devices()
        self.device_items = {}  # Lưu ID của từng item trong tree
        
        # Tạo danh sách ban đầu
        self.init_display()
        
        # Bắt đầu giám sát
        self.start_monitoring()
    
    def load_devices(self):
        """Đọc danh sách thiết bị từ file"""
        devices = []
        try:
            with open("D:\\danhsach.txt", "r", encoding="utf-8") as f:
                for line in f:
                    line = line.strip()
                    if line and "," in line:
                        name, ip = line.split(",", 1)
                        devices.append({"name": name.strip(), "ip": ip.strip()})
        except FileNotFoundError:
            print("⚠️ Không tìm thấy file D:\\danhsach.txt")
        return devices
    
    def init_display(self):
        """Tạo danh sách thiết bị ban đầu"""
        for idx, device in enumerate(self.devices, 1):
            item_id = self.tree.insert("", tk.END, 
                                      values=(idx, device["name"], device["ip"], 
                                             "⏳ Đang kiểm tra...", "---"))
            self.device_items[device["ip"]] = item_id
    
    def ping_device(self, ip):
        """Kiểm tra thiết bị online hay offline"""
        param = "-n" if platform.system().lower() == "windows" else "-c"
        command = ["ping", param, "1", "-w", "1000", ip]
        
        try:
            result = subprocess.run(command, stdout=subprocess.PIPE, 
                                  stderr=subprocess.PIPE, timeout=2)
            return result.returncode == 0
        except:
            return False
    
    def update_device_status(self, idx, device):
        """Cập nhật trạng thái của từng thiết bị"""
        is_online = self.ping_device(device["ip"])
        status = "🟢 ONLINE" if is_online else "🔴 OFFLINE"
        current_time = time.strftime("%H:%M:%S")
        tag = "online" if is_online else "offline"
        
        item_id = self.device_items.get(device["ip"])
        
        if item_id:
            # Cập nhật giá trị mà KHÔNG thay đổi focus
            self.tree.item(item_id, 
                          values=(idx, device["name"], device["ip"], status, current_time),
                          tags=(tag,))
        
        return is_online
    
    def update_all_devices(self):
        """Cập nhật tất cả thiết bị MÀ KHÔNG LÀM CUỘN MÀN HÌNH"""
        
        # LƯU VỊ TRÍ CUỘN HIỆN TẠI
        scroll_position = self.tree.yview()
        
        online_count = 0
        offline_count = 0
        
        # Cập nhật từng thiết bị
        for idx, device in enumerate(self.devices, 1):
            is_online = self.update_device_status(idx, device)
            if is_online:
                online_count += 1
            else:
                offline_count += 1
        
        # KHÔI PHỤC LẠI VỊ TRÍ CUỘN
        self.tree.yview_moveto(scroll_position[0])
        
        # Cập nhật thanh trạng thái
        total = len(self.devices)
        status_text = f"📊 Tổng: {total} thiết bị | 🟢 Online: {online_count} | 🔴 Offline: {offline_count} | ⏱️ Cập nhật: {time.strftime('%H:%M:%S')}"
        self.status_label.config(text=status_text)
    
    def start_monitoring(self):
        """Bắt đầu giám sát liên tục"""
        def monitor_loop():
            time.sleep(2)  # Đợi 2 giây trước khi bắt đầu
            while True:
                self.update_all_devices()
                time.sleep(5)  # Cập nhật mỗi 5 giây
        
        thread = threading.Thread(target=monitor_loop, daemon=True)
        thread.start()

# Chạy chương trình
if __name__ == "__main__":
    root = tk.Tk()
    app = DeviceMonitor(root)
    root.mainloop()
